__pycache__/
*.py[cod]
.pytest_cache/
.venv/
output/
.ruff_cache/

# Build / packaging artifacts — never commit. These are generated by
# `pip install -e .` / `python -m build` and only ever drift out of sync
# with the source tree (see the stale SOURCES.txt bug).
*.egg-info/
*.egg-link
*.egg
build/
dist/
.eggs/
develop-eggs/
sdist/

# Local FP8 kernel cache (written by cache_fp8_kernel.py at runtime).
.local/

# Local per-user env / secrets — never commit.
.env
.env.local
*.pem
*.key

# Internal data / results — never commit captures from internal logs.
data/
frames/
results/
bench/
context_results/
*.db3
*.mcap
*.bag
*.rosbag
*.pcd
*.npy
