# syntax=docker/dockerfile:1.7
#
# CUDA 12.6 build — targets GeForce RTX 4090 / Ampere–Ada (sm_80..sm_89)
# with a host driver that only supports CUDA <= 12.7 (e.g. 565.x).
# CUDA 13.x images will NOT run on these cards ("driver too old"), so this is
# the variant to use on a 4090 box. For Blackwell (5060 Ti / 5090) servers
# with a CUDA 13-capable driver, use docker/Dockerfile (the cu13 build).
#
# Base: official PyTorch CUDA 12.6 runtime. Torch + CUDA libs are supplied by
# the base image and are intentionally NOT reinstalled — requirements only adds
# the userspace packages (transformers, accelerate, the FP8 kernel runtime...).
#
# Build:
#   QWEN3_CU12=1 QWEN3_IMAGE=qwen3-vl:cu12 ./docker/build.sh
#   # or, pinning a different torch:
#   QWEN3_BASE_IMAGE=pytorch/pytorch:2.7.0-cuda12.6-cudnn9-runtime \
#     QWEN3_IMAGE=qwen3-vl:cu12 QWEN3_CU12=1 ./docker/build.sh
#
# 4090 (sm_89) verified working. Requires host driver >= 525 (CUDA 12.6).
ARG BASE_IMAGE=pytorch/pytorch:2.8.0-cuda12.6-cudnn9-runtime
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    GRADIO_ANALYTICS_ENABLED=false \
    TOKENIZERS_PARALLELISM=false \
    PYTORCH_ALLOC_CONF=expandable_segments:True \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/qwen3-vl

# The fine-grained FP8 Triton kernel is JIT-compiled on first forward and needs
# a C compiler (triton.runtime.build compiles a small CUDA helper with gcc/cc).
# The pytorch runtime base ships none, so install build-essential explicitly.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && command -v gcc >/dev/null 2>&1

# Add the userspace packages WITHOUT touching the base image's torch/cuda.
# requirements-container.txt deliberately omits torch/torchvision/triton so
# pip's resolver leaves the CUDA 12.6 wheels from the base image intact.
COPY requirements-container.txt /tmp/requirements-container.txt
RUN torch_before="$(python3 -c 'import torch; print(torch.__version__, torch.version.cuda)')" \
    && python3 -m pip install --no-cache-dir \
        -r /tmp/requirements-container.txt \
    && torch_after="$(python3 -c 'import torch; print(torch.__version__, torch.version.cuda)')" \
    && test "${torch_before}" = "${torch_after}" \
    && python3 -c 'import importlib.metadata as m; \
        expected={"transformers":"5.5.4","accelerate":"1.14.0","kernels":"0.14.1", \
                  "safetensors":"0.8.0","huggingface-hub":"1.16.1","Pillow":"12.1.1", \
                  "fastapi":"0.121.3","uvicorn":"0.49.0","python-multipart":"0.0.32", \
                  "av":"18.0.0","packaging":"25.0"}; \
        bad={k:(m.version(k),v) for k,v in expected.items() if m.version(k)!=v}; \
        assert not bad, bad' \
    && python3 -c 'import torch; assert torch.cuda.is_available() or True; \
        print("torch", torch.__version__, "cuda", torch.version.cuda)' \
    && python3 -m pip check \
    && rm -f /tmp/requirements-container.txt

# Cache the fine-grained FP8 Triton kernel once (build-time, online). The
# runtime never reaches the network for kernel code.
COPY docker/cache_fp8_kernel.py /tmp/cache_fp8_kernel.py
RUN HF_HOME=/tmp/fp8-kernel-hf-cache HF_HUB_OFFLINE=0 USE_HUB_KERNELS=1 \
        HF_HUB_DISABLE_TELEMETRY=0 DO_NOT_TRACK=0 \
        python3 /tmp/cache_fp8_kernel.py \
    && rm -rf /tmp/fp8-kernel-hf-cache /tmp/cache_fp8_kernel.py

ENV QWEN3_FP8_KERNEL_DIR=/opt/qwen-kernels/finegrained-fp8-v1 \
    LOCAL_KERNELS=kernels-community/finegrained-fp8=/opt/qwen-kernels/finegrained-fp8-v1 \
    USE_HUB_KERNELS=0

COPY . /opt/qwen3-vl

RUN test -s /opt/qwen-kernels/finegrained-fp8-v1/__init__.py \
    && test -s /opt/qwen-kernels/finegrained-fp8-v1/metadata.json \
    && python3 -m compileall -q /opt/qwen3-vl

EXPOSE 7860

HEALTHCHECK --interval=30s --timeout=5s --start-period=5m --retries=3 \
    CMD python3 -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('QWEN3_WEB_PORT', '7860') + '/healthz', timeout=3).read()" || exit 1

CMD ["python3", "-m", "demo.server", "--help"]
